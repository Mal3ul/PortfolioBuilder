
# --- PostgreSQL (pb-database) ---
POSTGRES_DB=portfolio_builder
POSTGRES_USER=pb_user
POSTGRES_PASSWORD=change-me-strong-password

# --- Auth (pb-app) ---
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=30m

# --- SMTP / emails (pb-app) ---
# NEUTRALIZE_EMAIL=true désactive l'envoi réel d'emails.
NEUTRALIZE_EMAIL=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nessia.eu
SMTP_FROM_NAME=PortfolioBuilder
SMTP_SECURE=false

# --- Cloudflare Tunnel (pb-tunnel) ---
TUNNEL_TOKEN=
